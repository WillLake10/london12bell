# Clean URLs for the static site: "/staging/results" instead of
# "/staging/results.html", and "/staging/" serves index.html without it
# appearing in the address bar (DirectoryIndex is the default on most
# Apache hosts, but set explicitly here so this keeps working even if
# the host's default ever changes).
DirectoryIndex index.html

RewriteEngine On

# A request for an existing page without its .html extension serves
# that file's content directly - the address bar stays on the clean URL.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# If a .html URL is requested directly (an old link, a bookmark), send
# a permanent redirect to the clean version instead of serving both.
RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
